# Copy this file to .env and fill in your values. NEVER commit the real .env.

# Google Gemini API key (required for AI summary/report generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model (optional; default in code is gemini-2.5-flash).
# Each model has its own free-tier quota; flash-lite has higher limits.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Hugging Face prediction Space (image -> attribute JSON)
HF_API_URL=https://shreyansh313-grin.hf.space/predict
# Secret only needed if the Space enforces an x-api-key header:
# HF_API_SECRET_KEY=

# CORS: comma-separated production frontend origins (localhost always allowed)
# FRONTEND_ORIGINS=https://lumera-frontend.onrender.com
